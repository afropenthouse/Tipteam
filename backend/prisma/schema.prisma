generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  fullName        String
  email           String           @unique
  password        String
  avatarUrl       String?
  isVerified      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  bookingProfiles BookingProfile[]
  businesses      Business[]
  subscriptions   Subscription[]
  verifications   Verification[]

  @@map("users")
}

model Verification {
  id        String           @id @default(uuid())
  userId    String
  type      VerificationType
  token     String?          @unique
  code      String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verifications")
}

model Business {
  id                String           @id @default(uuid())
  ownerId           String
  name              String
  email             String
  phone             String
  address           String
  website           String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  googleBusinessUrl String?
  allowTipping      Boolean          @default(false)
  bookingProfiles   BookingProfile[] @relation("BusinessBookingProfiles")
  owner             User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  feedbacks         Feedback[]
  menus             Menu[]
  receipts          Receipt[]
  services          Service[]
  staff             Staff[]
  withdrawals       Withdrawal[]
  customers         Customer[]

  @@map("businesses")
}

model Customer {
  id                 String                     @id @default(uuid())
  businessId         String
  name               String
  phone              String
  subscriptionStatus CustomerSubscriptionStatus @default(PENDING)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  business           Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  checkIns           CheckIn[]

  @@map("customers")
}

model CheckIn {
  id         String   @id @default(uuid())
  customerId String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("check_ins")
}

model Staff {
  id         String    @id @default(uuid())
  businessId String
  name       String
  role       String
  commission Float
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  receipts   Receipt[]
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("staff")
}

model Service {
  id         String    @id @default(uuid())
  businessId String
  name       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  amount     Float     @default(0)
  receipts   Receipt[]
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("services")
}

model Receipt {
  id         String   @id @default(uuid())
  businessId String
  staffId    String
  serviceId  String
  amount     Float
  date       DateTime
  imageUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("receipts")
}

model Menu {
  id         String    @id @default(uuid())
  businessId String?
  name       String
  publicId   String    @unique
  pdf        Bytes?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("menus")
}

model Feedback {
  id          String   @id @default(uuid())
  businessId  String
  rating      Int?
  experience  String?
  complaint   String?
  phone       String?
  tipAmount   Int      @default(0)
  paystackRef String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

model Withdrawal {
  id            String           @id @default(uuid())
  businessId    String
  amount        Int
  accountNumber String
  bankName      String
  bankCode      String?
  accountName   String?
  status        WithdrawalStatus @default(COMPLETED)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("withdrawals")
}

model Subscription {
  id          String             @id @default(uuid())
  userId      String
  planType    SubscriptionPlan
  duration    Int
  price       Int
  status      SubscriptionStatus @default(ACTIVE)
  startDate   DateTime           @default(now())
  endDate     DateTime
  paystackRef String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model BookingProfile {
  id               String            @id @default(uuid())
  userId           String
  businessId       String?
  name             String
  location         String
  description      String?
  publicId         String            @unique @default(uuid())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  services         String[]          @default([])
  business         Business?         @relation("BusinessBookingProfiles", fields: [businessId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pictures         BookingPicture[]
  bookings         Booking[]
  unavailableDates UnavailableDate[]
}

model BookingPicture {
  id               String         @id @default(uuid())
  bookingProfileId String
  imageUrl         String
  publicId         String?
  createdAt        DateTime       @default(now())
  bookingProfile   BookingProfile @relation(fields: [bookingProfileId], references: [id], onDelete: Cascade)

  @@map("booking_pictures")
}

model UnavailableDate {
  id               String         @id @default(uuid())
  bookingProfileId String
  date             DateTime
  createdAt        DateTime       @default(now())
  endTime          String?
  startTime        String?
  bookingProfile   BookingProfile @relation(fields: [bookingProfileId], references: [id], onDelete: Cascade)

  @@map("unavailable_dates")
}

model Booking {
  id               String         @id @default(uuid())
  bookingProfileId String
  date             DateTime
  customerName     String
  customerPhone    String
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  time             String?
  bookingProfile   BookingProfile @relation(fields: [bookingProfileId], references: [id], onDelete: Cascade)

  @@map("bookings")
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  WITHDRAWAL_VERIFICATION
}

enum WithdrawalStatus {
  COMPLETED
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionPlan {
  THREE_MONTHS
  SIX_MONTHS
  NINE_MONTHS
  TWELVE_MONTHS
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum CustomerSubscriptionStatus {
  ACTIVE
  INACTIVE
  PENDING
}
