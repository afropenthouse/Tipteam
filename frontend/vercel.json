{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "FRONTEND_URL": "https://tipteam.vercel.app",
    "VITE_API_URL": "https://tipteam.onrender.com/api"
  }
}