{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "FRONTEND_URL": "https://tipteam.vercel.app",
    "VITE_API_URL": "https://tipteam.onrender.com/api"
  }
}